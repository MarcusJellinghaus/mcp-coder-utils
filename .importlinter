# =============================================================================
# Import Linter Configuration
# =============================================================================
# Enforces architectural boundaries for mcp_coder_utils.
# Run with: lint-imports
#
# This is a leaf library — it has no internal dependencies on other mcp-coder
# repos. The contracts below enforce that property and isolate third-party
# libraries to the modules that own them.
# =============================================================================

[importlinter]
root_packages =
    mcp_coder_utils
    tests
root_package_paths =
    src
    .
include_external_packages = True

# -----------------------------------------------------------------------------
# Contract: Source Code Independence from Tests
# -----------------------------------------------------------------------------
# Production code must never import from test modules.
# -----------------------------------------------------------------------------
[importlinter:contract:no_test_imports_in_source]
name = Source Code Independence from Tests
type = forbidden
source_modules =
    mcp_coder_utils
forbidden_modules =
    tests

# -----------------------------------------------------------------------------
# Contract: Leaf Library — No Internal mcp-coder Dependencies
# -----------------------------------------------------------------------------
# mcp_coder_utils is the leaf in the mcp-coder dependency graph. It must not
# import from any sibling repo (mcp_coder, mcp_tools_py, mcp_workspace,
# mcp_config). Doing so would create a cycle.
# -----------------------------------------------------------------------------
[importlinter:contract:leaf_library]
name = Leaf Library — No Internal mcp-coder Dependencies
type = forbidden
source_modules =
    mcp_coder_utils
forbidden_modules =
    mcp_coder
    mcp_tools_py
    mcp_workspace
    mcp_config

# -----------------------------------------------------------------------------
# Contract: Subprocess Library Isolation
# -----------------------------------------------------------------------------
# The 'subprocess' module should only be used by subprocess_runner and
# subprocess_streaming. All other modules must use them as an abstraction layer.
# Enforced in tests as well.
# Process spawning via os.system/os.popen/asyncio and git argv lists are caught
# by `tools/check_forbidden_calls.py` (rules `subprocess` and `git`).
#
# Permanent exceptions:
#   - tests.test_subprocess_runner: patches subprocess.Popen and asserts
#     subprocess constants to exercise subprocess_runner itself
# tools/ is outside root_packages and unchecked.
# -----------------------------------------------------------------------------
[importlinter:contract:subprocess_isolation]
name = Subprocess Library Isolation
type = forbidden
source_modules =
    mcp_coder_utils
    tests
forbidden_modules =
    subprocess
ignore_imports =
    mcp_coder_utils.subprocess_runner -> subprocess
    mcp_coder_utils.subprocess_streaming -> subprocess
    tests.test_subprocess_runner -> subprocess
