# =============================================================================
# Import Linter Configuration
# =============================================================================
# Enforces architectural boundaries for mcp_coder_utils.
# Run with: lint-imports
#
# This is a leaf library — it has no internal dependencies on other mcp-coder
# repos. The contracts below enforce that property and isolate third-party
# libraries to the modules that own them.
# =============================================================================

[importlinter]
root_packages =
    mcp_coder_utils
    tests
root_package_paths =
    src
    .
include_external_packages = True

# -----------------------------------------------------------------------------
# Contract: Source Code Independence from Tests
# -----------------------------------------------------------------------------
# Production code must never import from test modules.
# -----------------------------------------------------------------------------
[importlinter:contract:no_test_imports_in_source]
name = Source Code Independence from Tests
type = forbidden
source_modules =
    mcp_coder_utils
forbidden_modules =
    tests

# -----------------------------------------------------------------------------
# Contract: Leaf Library — No Internal mcp-coder Dependencies
# -----------------------------------------------------------------------------
# mcp_coder_utils is the leaf in the mcp-coder dependency graph. It must not
# import from any sibling repo (mcp_coder, mcp_tools_py, mcp_workspace,
# mcp_config, mcp_tools_sql, agent_workbench). Doing so would create a cycle.
# -----------------------------------------------------------------------------
[importlinter:contract:leaf_library]
name = Leaf Library — No Internal mcp-coder Dependencies
type = forbidden
source_modules =
    mcp_coder_utils
forbidden_modules =
    mcp_coder
    mcp_tools_py
    mcp_workspace
    mcp_config
    mcp_tools_sql
    agent_workbench

# -----------------------------------------------------------------------------
# Contract: No MCP or Agent Framework Dependencies
# -----------------------------------------------------------------------------
# Covers every module of the package. The tool contracts (tool_spec,
# tool_provider, tool_verify) are consumed by FastMCP servers and non-MCP apps
# (LangGraph, agent-workbench), so the library must stay framework-neutral.
# -----------------------------------------------------------------------------
[importlinter:contract:no_agent_frameworks]
name = No MCP or Agent Framework Dependencies
type = forbidden
source_modules =
    mcp_coder_utils
forbidden_modules =
    mcp
    langchain
    langchain_core
    chainlit

# -----------------------------------------------------------------------------
# Contract: Tool Provider Contract Stays Light
# -----------------------------------------------------------------------------
# tool_provider and tool_verify sit on consumers' start paths. jsonschema
# (~125 ms, with referencing) belongs to toolkit only. Forbidding toolkit too
# makes a violation name the cause. Runtime check: tests/test_tool_provider.py.
# -----------------------------------------------------------------------------
[importlinter:contract:light_tool_provider]
name = Tool Provider Contract Stays Light
type = forbidden
source_modules =
    mcp_coder_utils.tool_provider
    mcp_coder_utils.tool_verify
forbidden_modules =
    jsonschema
    referencing
    mcp_coder_utils.toolkit

# -----------------------------------------------------------------------------
# Contract: Subprocess Library Isolation
# -----------------------------------------------------------------------------
# The 'subprocess' module should only be used by subprocess_runner and
# subprocess_streaming. All other modules must use them as an abstraction layer.
# Enforced in tests as well.
# Process spawning via os.system/os.popen/asyncio and git argv lists are caught
# by `tools/check_forbidden_calls.py` (rules `subprocess` and `git`).
#
# Permanent exceptions:
#   - tests.test_subprocess_runner_execute, tests.test_subprocess_runner_process:
#     patch subprocess.Popen and assert subprocess constants to exercise
#     subprocess_runner itself
# tools/ is outside root_packages and unchecked.
# -----------------------------------------------------------------------------
[importlinter:contract:subprocess_isolation]
name = Subprocess Library Isolation
type = forbidden
source_modules =
    mcp_coder_utils
    tests
forbidden_modules =
    subprocess
ignore_imports =
    mcp_coder_utils.subprocess_runner -> subprocess
    mcp_coder_utils.subprocess_streaming -> subprocess
    mcp_coder_utils.subprocess_helpers -> subprocess
    tests.test_subprocess_runner_execute -> subprocess
    tests.test_subprocess_runner_process -> subprocess
